{
  "name": "expo-nextjs-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "next:dev": "next dev --webpack",
    "next:build": "next build --webpack",
    "next:start": "next start",
    "next:lint": "eslint app src scripts --max-warnings=0",
    "expo:start": "expo start",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios",
    "expo:web": "expo start --web",
    "expo:export:android": "expo export --platform android --output-dir dist-native --clear",
    "expo:export:ios": "expo export --platform ios --output-dir dist-ios --clear",
    "expo:export:web": "expo export --platform web --output-dir dist-web --clear",
    "expo:test": "jest --watchAll",
    "expo:lint": "expo lint",
    "lint": "eslint app src scripts --max-warnings=0",
    "typecheck": "tsc --project tsconfig.core.json --noEmit",
    "typecheck:components": "tsc --project src/components/tsconfig.json --noEmit",
    "typecheck:next": "node scripts/refresh-next-types.mjs && next typegen && tsc --project tsconfig.next.json --noEmit",
    "routes:check": "node scripts/check-route-parity.mjs",
    "architecture:check": "node scripts/check-architecture.mjs",
    "performance:check": "node scripts/check-performance.mjs",
    "ui-framework:check": "node scripts/check-ui-framework.mjs",
    "components:check": "node scripts/check-component-coverage.mjs",
    "nativewind:check": "node scripts/check-nativewind-only.mjs",
    "react-native-text:check": "node scripts/check-react-native-text-nodes.mjs",
    "check": "node scripts/check-architecture.mjs && node scripts/check-performance.mjs && node scripts/check-ui-framework.mjs && node scripts/check-component-coverage.mjs && node scripts/check-nativewind-only.mjs && node scripts/check-react-native-text-nodes.mjs && node scripts/check-route-parity.mjs && tsc --project src/components/tsconfig.json --noEmit && tsc --project tsconfig.core.json --noEmit && node scripts/refresh-next-types.mjs && next typegen && tsc --project tsconfig.next.json --noEmit && eslint app src scripts --max-warnings=0"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "^5.2.0",
    "@react-native-picker/picker": "~2.11.4",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "expo": "57.0.13",
    "expo-battery": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "^57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "^57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.10",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "^57.0.6",
    "expo-localization": "~57.0.1",
    "expo-location": "~57.0.10",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.13",
    "expo-sharing": "~57.0.12",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "^57.0.6",
    "expo-status-bar": "^57.0.1",
    "expo-web-browser": "~57.0.2",
    "moti": "^0.30.0",
    "next": "^16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.2",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-marked": "^8.1.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "babel-loader": "^10.1.1",
    "babel-preset-expo": "^57.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "nativewind": "^4.2.6",
    "postcss": "^8.5.26",
    "react-refresh": "^0.14.2",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=25"
  }
}

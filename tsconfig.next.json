{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "nativewind-env.d.ts",
    "types/**/*.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/composition/**/*.ts",
    "src/composition/**/*.tsx",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    "src/modules/**/*.ts",
    "src/modules/**/*.tsx",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/views/**/*.ts",
    "src/views/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    ".next/cache",
    "dist",
    "dist-*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
